<launch>
    <!-- One shared distributed implementation; rows and columns select the formation. -->
    <arg name="formation_rows" default="2"/>
    <arg name="formation_columns" default="4"/>
    <arg name="row_spacing" default="1.0"/>
    <arg name="column_spacing" default="1.0"/>
    <arg name="rviz" default="true"/>
    <arg name="swap_enabled" default="true"/>
    <arg name="swap_scope" default="all"/>
    <arg name="max_vel" default="0.5"/>
    <arg name="map_size_x" default="32.0"/>
    <arg name="map_size_y" default="14.0"/>
    <arg name="map_size_z" default="3.0"/>
    <arg name="start_x" default="-14.0"/>
    <arg name="goal_x" default="14.0"/>
    <arg name="altitude" default="1.5"/>
    <arg name="odom_topic" default="visual_slam/odom"/>
    <arg name="safety_distance" default="0.2"/>
    <arg name="formation_weight" default="200.0"/>
    <arg name="weak_reconnect_distance" default="4.0"/>
    <arg name="distributed_startup_timeout" default="60.0"/>
    <arg name="random_seed" default="17"/>
    <arg name="small_position_seed" default="-1"/>
    <arg name="large_obstacle_count" default="4"/>
    <arg name="small_obstacle_count" default="6"/>
    <arg name="endpoint_clearance" default="3.0"/>
    <arg name="obstacle_separation" default="0.7"/>
    <arg name="goal_side_obstacle_size_y" default="4.0"/>
    <arg name="goal_side_obstacle_center_y" default="0.0"/>
    <arg name="large_longitudinal_separation" default="3.5"/>
    <arg name="small_center_y_limit" default="2.0"/>
    <arg name="structured_challenge_enabled" default="true"/>
    <arg name="stacked_cluster_x" default="-2.0"/>
    <arg name="narrow_gap_x" default="4.8"/>
    <arg name="narrow_gap_size_y" default="1.6"/>

    <node pkg="ego_planner" type="launch_distributed_formation.py"
          name="distributed_formation_launcher" output="screen" required="true">
        <param name="scene" value="sparse_random"/>
        <param name="formation_rows" value="$(arg formation_rows)"/>
        <param name="formation_columns" value="$(arg formation_columns)"/>
        <param name="row_spacing" value="$(arg row_spacing)"/>
        <param name="column_spacing" value="$(arg column_spacing)"/>
        <param name="rviz" value="$(arg rviz)"/>
        <param name="swap_enabled" value="$(arg swap_enabled)"/>
        <param name="swap_scope" value="$(arg swap_scope)"/>
        <param name="max_vel" value="$(arg max_vel)"/>
        <param name="map_size_x" value="$(arg map_size_x)"/>
        <param name="map_size_y" value="$(arg map_size_y)"/>
        <param name="map_size_z" value="$(arg map_size_z)"/>
        <param name="start_x" value="$(arg start_x)"/>
        <param name="goal_x" value="$(arg goal_x)"/>
        <param name="altitude" value="$(arg altitude)"/>
        <param name="odom_topic" value="$(arg odom_topic)"/>
        <param name="safety_distance" value="$(arg safety_distance)"/>
        <param name="formation_weight" value="$(arg formation_weight)"/>
        <param name="weak_reconnect_distance" value="$(arg weak_reconnect_distance)"/>
        <param name="distributed_startup_timeout" value="$(arg distributed_startup_timeout)"/>
        <param name="random_seed" value="$(arg random_seed)"/>
        <param name="small_position_seed" value="$(arg small_position_seed)"/>
        <param name="large_obstacle_count" value="$(arg large_obstacle_count)"/>
        <param name="small_obstacle_count" value="$(arg small_obstacle_count)"/>
        <param name="endpoint_clearance" value="$(arg endpoint_clearance)"/>
        <param name="obstacle_separation" value="$(arg obstacle_separation)"/>
        <param name="goal_side_obstacle_size_y" value="$(arg goal_side_obstacle_size_y)"/>
        <param name="goal_side_obstacle_center_y" value="$(arg goal_side_obstacle_center_y)"/>
        <param name="large_longitudinal_separation" value="$(arg large_longitudinal_separation)"/>
        <param name="small_center_y_limit" value="$(arg small_center_y_limit)"/>
        <param name="structured_challenge_enabled" value="$(arg structured_challenge_enabled)"/>
        <param name="stacked_cluster_x" value="$(arg stacked_cluster_x)"/>
        <param name="narrow_gap_x" value="$(arg narrow_gap_x)"/>
        <param name="narrow_gap_size_y" value="$(arg narrow_gap_size_y)"/>
    </node>
</launch>

