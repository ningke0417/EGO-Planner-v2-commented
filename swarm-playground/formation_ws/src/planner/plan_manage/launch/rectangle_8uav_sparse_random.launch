<launch>
    <arg name="rviz" default="true"/>
    <arg name="random_seed" default="17"/>
    <arg name="small_position_seed" default="-1" doc="negative: original layout; nonnegative: independently resample small obstacle positions; matches EGO-Planner-v2-commented"/>
    <arg name="max_vel" default="0.5"/>
    <arg name="map_size_x" default="32.0"/>
    <arg name="map_size_y" default="14.0"/>
    <arg name="map_size_z" default="3.0"/>
    <arg name="start_x" default="-14.0"/>
    <arg name="goal_x" default="14.0"/>
    <arg name="large_obstacle_count" default="4"/>
    <arg name="small_obstacle_count" default="6" doc="Small blocks only; 0 removes them. Keep random_seed=17 to preserve large, stacked and narrow-gap obstacles."/>
    <arg name="endpoint_clearance" default="3.0"/>
    <arg name="obstacle_separation" default="0.7"/>
    <arg name="goal_side_obstacle_size_y" default="4.0"/>
    <arg name="goal_side_obstacle_center_y" default="0.0"/>
    <arg name="large_longitudinal_separation" default="3.5"/>
    <arg name="small_center_y_limit" default="2.0"/>
    <arg name="structured_challenge_enabled" default="true"/>
    <arg name="stacked_cluster_x" default="-2.0"/>
    <arg name="narrow_gap_x" default="4.8"/>
    <arg name="narrow_gap_size_y" default="1.6"/>
    <include file="$(find ego_planner)/launch/baseline_sparse_random_map.launch">
        <arg name="random_seed" value="$(arg random_seed)"/>
        <arg name="small_position_seed" value="$(arg small_position_seed)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="start_x" value="$(arg start_x)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="large_obstacle_count" value="$(arg large_obstacle_count)"/>
        <arg name="small_obstacle_count" value="$(arg small_obstacle_count)"/>
        <arg name="endpoint_clearance" value="$(arg endpoint_clearance)"/>
        <arg name="obstacle_separation" value="$(arg obstacle_separation)"/>
        <arg name="goal_side_obstacle_size_y" value="$(arg goal_side_obstacle_size_y)"/>
        <arg name="goal_side_obstacle_center_y" value="$(arg goal_side_obstacle_center_y)"/>
        <arg name="large_longitudinal_separation" value="$(arg large_longitudinal_separation)"/>
        <arg name="small_center_y_limit" value="$(arg small_center_y_limit)"/>
        <arg name="structured_challenge_enabled" value="$(arg structured_challenge_enabled)"/>
        <arg name="stacked_cluster_x" value="$(arg stacked_cluster_x)"/>
        <arg name="narrow_gap_x" value="$(arg narrow_gap_x)"/>
        <arg name="narrow_gap_size_y" value="$(arg narrow_gap_size_y)"/>
    </include>
    <arg name="safety_distance" default="0.2"/>
    <arg name="formation_weight" default="200"/>
    <arg name="start_planning" default="true"/>
    <arg name="full_360_sensing" default="true"/>
    <arg name="record_bag" default="false"/>
    <arg name="bag_prefix" default="/tmp/ego_original_8uav_random"/>
    <include file="$(find ego_planner)/launch/rectangle_8uav_fixed_split_merge_wall.launch">
        <arg name="map_source" value="external"/>
        <arg name="rviz" value="$(arg rviz)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="start_x" value="$(arg start_x)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="formation_weight" value="$(arg formation_weight)"/>
        <arg name="start_planning" value="$(arg start_planning)"/>
        <arg name="full_360_sensing" value="$(arg full_360_sensing)"/>
        <arg name="record_bag" value="$(arg record_bag)"/>
        <arg name="bag_prefix" value="$(arg bag_prefix)"/>
    </include>
</launch>
