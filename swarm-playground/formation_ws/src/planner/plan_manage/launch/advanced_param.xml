<launch>
    <arg name="distributed_enabled" default="false"/>
    <arg name="map_size_x_"/>
    <arg name="map_size_y_"/>
    <arg name="map_size_z_"/>
    <arg name="odometry_topic"/>
    <arg name="camera_pose_topic"/>
    <arg name="depth_topic"/>
    <arg name="cloud_topic"/>
    <arg name="cx"/>
    <arg name="cy"/>
    <arg name="fx"/>
    <arg name="fy"/>
    <arg name="max_vel"/>
    <arg name="max_acc"/>
    <arg name="max_jer"/>
    <arg name="planning_horizon"/>
    <arg name="point_num"/>
    <arg name="point0_x"/>
    <arg name="point0_y"/>
    <arg name="point0_z"/>
    <arg name="point1_x"/>
    <arg name="point1_y"/>
    <arg name="point1_z"/>
    <arg name="point2_x"/>
    <arg name="point2_y"/>
    <arg name="point2_z"/>
    <arg name="point3_x"/>
    <arg name="point3_y"/>
    <arg name="point3_z"/>
    <arg name="point4_x"/>
    <arg name="point4_y"/>
    <arg name="point4_z"/>
    <arg name="flight_type"/>
    <arg name="use_distinctive_trajs"/>
    <arg name="obj_num_set"/>
    <arg name="drone_id"/>
    <arg name="obstacles_inflation" default="0.0"/>
    <arg name="obstacle_clearance" default="0.1"/>
    <arg name="manual_formation_split" default="false"/>
    <arg name="general_dynamic_topology_enabled" default="false"/>
    <arg name="initial_assignment_enabled" default="false"/>
    <arg name="split_side_guidance_enabled" default="false"/>
    <arg name="split_side_guidance_weight" default="600.0"/>
    <arg name="split_side_guidance_margin" default="0.35"/>
    <arg name="split_side_guidance_center_y" default="0.0"/>
    <arg name="split_subgroup_formation_weight_scale" default="1.0"/>
    <arg name="split_progress_sync_weight_scale" default="0.0"/>
    <arg name="split_progress_sync_deadband" default="0.6"/>
    <arg name="merge_sync_enabled" default="false"/>
    <arg name="merge_sync_duration" default="8.0"/>
    <arg name="merge_sync_backtrack_tolerance" default="0.03"/>
    <arg name="merge_sync_weight" default="1000.0"/>
    <arg name="subgroup_route_intent_feedback_enabled" default="false"/>
    <arg name="subgroup_route_intent_topic" default="/subgroup_route_intent_4uav/intents"/>
    <arg name="subgroup_route_intent_weight" default="80.0"/>
    <arg name="subgroup_route_intent_corridor_half_width" default="0.25"/>
    <arg name="formation_weight" default="100"/>
    <arg name="use_wall_collision_guard" default="false"/>
    <arg name="wall_x" default="0.0"/>
    <arg name="wall_y" default="0.0"/>
    <arg name="wall_size_x" default="0.0"/>
    <arg name="wall_size_y" default="0.0"/>
    <arg name="wall_safety_distance" default="0.0"/>
    <arg name="wall_guard_check_horizon" default="3.0"/>
    <arg name="formation_num" default="7"/>
    <arg name="formation_start_x" default="-32.0"/>
    <arg name="formation_start_y" default="0.0"/>
    <arg name="formation_start_z" default="1.0"/>
    <arg name="formation_drone0_x" default="1.0"/>
    <arg name="formation_drone0_y" default="-0.5"/>
    <arg name="formation_drone1_x" default="1.0"/>
    <arg name="formation_drone1_y" default="0.5"/>
    <arg name="formation_drone2_x" default="0.0"/>
    <arg name="formation_drone2_y" default="-1.0"/>
    <arg name="formation_drone3_x" default="0.0"/>
    <arg name="formation_drone3_y" default="0.0"/>
    <arg name="formation_drone4_x" default="0.0"/>
    <arg name="formation_drone4_y" default="1.0"/>
    <arg name="formation_drone5_x" default="-1.0"/>
    <arg name="formation_drone5_y" default="-0.5"/>
    <arg name="formation_drone6_x" default="-1.0"/>
    <arg name="formation_drone6_y" default="0.5"/>
    <arg name="formation_drone7_x" default="-1.0"/>
    <arg name="formation_drone7_y" default="1.5"/>
    <!-- main node -->
    <!-- <node pkg="ego_planner" name="ego_planner_node" type="ego_planner_node" output="screen" launch-prefix="valgrind"> -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_ego_planner_node" type="ego_planner_node" output="screen">
        <param name="formation/distributed_enabled" value="$(arg distributed_enabled)"/>
        <remap from="~odom_world" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
        <remap from="~mandatory_stop" to="/mandatory_stop_to_planner"/>
        <remap from="~planning/trajectory" to = "/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~planning/data_display" to = "/drone_$(arg drone_id)_planning/data_display"/>
        <remap from="~planning/broadcast_traj_send" to="$(eval '/swarm/trajectories' if arg('distributed_enabled') else '/broadcast_traj_from_planner')"/>
        <remap from="~planning/broadcast_traj_recv" to="$(eval '/swarm/trajectories' if arg('distributed_enabled') else '/broadcast_traj_to_planner')"/>
        <remap from="~planning/heartbeat" to = "/drone_$(arg drone_id)_traj_server/heartbeat"/>
        <remap from="~grid_map/odom" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
        <remap from="~grid_map/cloud" to="/drone_$(arg drone_id)_$(arg cloud_topic)"/>
        <remap from="~grid_map/pose"   to = "/drone_$(arg drone_id)_$(arg camera_pose_topic)"/>
        <remap from="~grid_map/depth" to = "/drone_$(arg drone_id)_$(arg depth_topic)"/>
        <!-- planning fsm -->
        <param name="fsm/flight_type" value="$(arg flight_type)" type="int"/>
        <param name="fsm/thresh_replan_time" value="1.0" type="double"/>
        <param name="fsm/thresh_no_replan_meter" value="1.0" type="double"/>
        <param name="fsm/arrival_position_tolerance" value="0.30" type="double"/>
        <param name="fsm/arrival_speed_tolerance" value="0.15" type="double"/>
        <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/>
        <!--always set to 1.5 times grater than sensing horizen-->
        <param name="fsm/emergency_time" value="1.0" type="double"/>
        <param name="fsm/realworld_experiment" value="false"/>
        <param name="fsm/fail_safe" value="true"/>
        <param name="fsm/waypoint_num" value="$(arg point_num)" type="int"/>
        <param name="fsm/waypoint0_x" value="$(arg point0_x)" type="double"/>
        <param name="fsm/waypoint0_y" value="$(arg point0_y)" type="double"/>
        <param name="fsm/waypoint0_z" value="$(arg point0_z)" type="double"/>
        <param name="fsm/waypoint1_x" value="$(arg point1_x)" type="double"/>
        <param name="fsm/waypoint1_y" value="$(arg point1_y)" type="double"/>
        <param name="fsm/waypoint1_z" value="$(arg point1_z)" type="double"/>
        <param name="fsm/waypoint2_x" value="$(arg point2_x)" type="double"/>
        <param name="fsm/waypoint2_y" value="$(arg point2_y)" type="double"/>
        <param name="fsm/waypoint2_z" value="$(arg point2_z)" type="double"/>
        <param name="fsm/waypoint3_x" value="$(arg point3_x)" type="double"/>
        <param name="fsm/waypoint3_y" value="$(arg point3_y)" type="double"/>
        <param name="fsm/waypoint3_z" value="$(arg point3_z)" type="double"/>
        <param name="fsm/waypoint4_x" value="$(arg point4_x)" type="double"/>
        <param name="fsm/waypoint4_y" value="$(arg point4_y)" type="double"/>
        <param name="fsm/waypoint4_z" value="$(arg point4_z)" type="double"/>
        <param name="grid_map/resolution" value="0.1" />
        <param name="grid_map/map_size_x" value="$(arg map_size_x_)" />
        <param name="grid_map/map_size_y" value="$(arg map_size_y_)" />
        <param name="grid_map/map_size_z" value="$(arg map_size_z_)" />
        <param name="grid_map/local_update_range_x" value="5.5" />
        <param name="grid_map/local_update_range_y" value="5.5" />
        <param name="grid_map/local_update_range_z" value="4.5" />
        <param name="grid_map/obstacles_inflation" value="$(arg obstacles_inflation)" type="double"/>
        <param name="grid_map/local_map_margin" value="10"/>
        <param name="grid_map/ground_height" value="-0.01"/>
        <!-- camera parameter -->
        <param name="grid_map/cx" value="$(arg cx)"/>
        <param name="grid_map/cy" value="$(arg cy)"/>
        <param name="grid_map/fx" value="$(arg fx)"/>
        <param name="grid_map/fy" value="$(arg fy)"/>
        <!-- depth filter -->
        <param name="grid_map/use_depth_filter" value="true"/>
        <param name="grid_map/depth_filter_tolerance" value="0.15"/>
        <param name="grid_map/depth_filter_maxdist" value="5.0"/>
        <param name="grid_map/depth_filter_mindist" value="0.2"/>
        <param name="grid_map/depth_filter_margin" value="2"/>
        <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
        <param name="grid_map/skip_pixel" value="2"/>
        <!-- local fusion -->
        <param name="grid_map/p_hit" value="0.65"/>
        <param name="grid_map/p_miss" value="0.35"/>
        <param name="grid_map/p_min" value="0.12"/>
        <param name="grid_map/p_max" value="0.90"/>
        <param name="grid_map/p_occ" value="0.80"/>
        <param name="grid_map/min_ray_length" value="0.1"/>
        <param name="grid_map/max_ray_length" value="4.5"/>
        <param name="grid_map/visualization_truncate_height" value="1.9"/>
        <param name="grid_map/show_occ_time" value="false"/>
        <param name="grid_map/pose_type" value="1"/>
        <param name="grid_map/frame_id" value="world"/>
        <!-- planner manager -->
        <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
        <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
        <param name="manager/polyTraj_piece_length" value="1.5" type="double"/>
        <param name="manager/feasibility_tolerance" value="0.05" type="double"/>
        <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>
        <param name="manager/use_distinctive_trajs" value="$(arg use_distinctive_trajs)" type="bool"/>
        <param name="manager/drone_id" value="$(arg drone_id)"/>
        <param name="manager/use_wall_collision_guard" value="$(arg use_wall_collision_guard)" type="bool"/>
        <param name="manager/wall_x" value="$(arg wall_x)" type="double"/>
        <param name="manager/wall_y" value="$(arg wall_y)" type="double"/>
        <param name="manager/wall_size_x" value="$(arg wall_size_x)" type="double"/>
        <param name="manager/wall_size_y" value="$(arg wall_size_y)" type="double"/>
        <param name="manager/wall_safety_distance" value="$(arg wall_safety_distance)" type="double"/>
        <param name="manager/wall_guard_check_horizon" value="$(arg wall_guard_check_horizon)" type="double"/>
        <!-- trajectory optimization -->
        <param name="optimization/constraint_points_perPiece" value="8" type="int"/>
        <param name="optimization/weight_obstacle" value="10000.0" type="double"/>
        <param name="optimization/weight_obstacle_soft" value="10000.0" type="double"/>
        <param name="optimization/weight_swarm" value="10000.0" type="double"/>
        <param name="optimization/weight_feasibility" value="10000.0" type="double"/>
        <param name="optimization/weight_sqrvariance" value="10000.0" type="double"/>
        <param name="optimization/weight_time" value="10.0" type="double"/>
        <param name="optimization/weight_formation" value="$(arg formation_weight)" type="double"/>
        <param name="optimization/obstacle_clearance" value="$(arg obstacle_clearance)" type="double"/>
        <param name="optimization/obstacle_clearance_soft" value="0.5" type="double"/>
        <param name="optimization/swarm_clearance" value="0.5" type="double"/>
        <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
        <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>
        <param name="optimization/max_jer" value="$(arg max_jer)" type="double"/>
        <param name="optimization/record_opt" value="true"/>
        <!-- formation-->
        <param name="formation/num" value="$(arg formation_num)" type="int"/>
        <param name="formation/manual_split" value="$(arg manual_formation_split)" type="bool"/>
        <param name="formation/general_dynamic_topology_enabled" value="$(arg general_dynamic_topology_enabled)" type="bool"/>
        <param name="formation/initial_assignment_enabled" value="$(arg initial_assignment_enabled)" type="bool"/>
        <param name="formation/split_side_guidance_enabled" value="$(arg split_side_guidance_enabled)" type="bool"/>
        <param name="formation/split_side_guidance_weight" value="$(arg split_side_guidance_weight)" type="double"/>
        <param name="formation/split_side_guidance_margin" value="$(arg split_side_guidance_margin)" type="double"/>
        <param name="formation/split_side_guidance_center_y" value="$(arg split_side_guidance_center_y)" type="double"/>
        <param name="formation/split_subgroup_formation_weight_scale" value="$(arg split_subgroup_formation_weight_scale)" type="double"/>
        <param name="formation/split_progress_sync_weight_scale" value="$(arg split_progress_sync_weight_scale)" type="double"/>
        <param name="formation/split_progress_sync_deadband" value="$(arg split_progress_sync_deadband)" type="double"/>
        <param name="formation/merge_sync_enabled" value="$(arg merge_sync_enabled)" type="bool"/>
        <param name="formation/merge_sync_duration" value="$(arg merge_sync_duration)" type="double"/>
        <param name="formation/merge_sync_backtrack_tolerance" value="$(arg merge_sync_backtrack_tolerance)" type="double"/>
        <param name="formation/merge_sync_weight" value="$(arg merge_sync_weight)" type="double"/>
        <param name="formation/subgroup_route_intent_feedback_enabled" value="$(arg subgroup_route_intent_feedback_enabled)" type="bool"/>
        <param name="formation/subgroup_route_intent_topic" value="$(arg subgroup_route_intent_topic)" type="string"/>
        <param name="formation/subgroup_route_intent_weight" value="$(arg subgroup_route_intent_weight)" type="double"/>
        <param name="formation/subgroup_route_intent_corridor_half_width" value="$(arg subgroup_route_intent_corridor_half_width)" type="double"/>
        <param name="formation/subgroup_route_intent_timeout" value="1.0" type="double"/>
        <param name="formation/subgroup_route_intent_replan_angle" value="0.261799" type="double"/>
        <param name="formation/subgroup_route_intent_replan_gain_step" value="0.20" type="double"/>
        <param name="formation/subgroup_route_intent_replan_interval" value="0.5" type="double"/>
        <rosparam subst_value="true" param="formation/start">[$(arg formation_start_x), $(arg formation_start_y), $(arg formation_start_z)]</rosparam>
        <rosparam subst_value="true" param="formation/drone0">[$(arg formation_drone0_x), $(arg formation_drone0_y), 0]</rosparam>
        <rosparam subst_value="true" param="formation/drone1">[$(arg formation_drone1_x), $(arg formation_drone1_y), 0]</rosparam>
        <rosparam subst_value="true" param="formation/drone2">[$(arg formation_drone2_x), $(arg formation_drone2_y), 0]</rosparam>
        <rosparam subst_value="true" param="formation/drone3">[$(arg formation_drone3_x), $(arg formation_drone3_y), 0]</rosparam>
        <rosparam subst_value="true" param="formation/drone4">[$(arg formation_drone4_x), $(arg formation_drone4_y), 0]</rosparam>
        <rosparam subst_value="true" param="formation/drone5">[$(arg formation_drone5_x), $(arg formation_drone5_y), 0]</rosparam>
        <rosparam subst_value="true" param="formation/drone6">[$(arg formation_drone6_x), $(arg formation_drone6_y), 0]</rosparam>
        <rosparam subst_value="true" param="formation/drone7">[$(arg formation_drone7_x), $(arg formation_drone7_y), 0]</rosparam>
    </node>
</launch>
