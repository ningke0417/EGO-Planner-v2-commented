<launch>
    <arg name="coordination_mode" default="centralized" doc="centralized or distributed"/>
    <arg name="swap_enabled" default="false"/>
    <arg name="distributed_enabled" value="$(eval {'centralized': False, 'distributed': True}[arg('coordination_mode')])"/>
    <param name="/distributed_swap_enabled" value="$(arg swap_enabled)"/>
    <!-- Eight-UAV dynamic split/merge experiment in the unchanged wall map. -->
    <arg name="rviz" default="true"/>
    <arg name="map_source" default="split_merge_wall"/>
    <arg name="max_vel" default="0.5"/>
    <arg name="map_size_x" default="24.0"/>
    <arg name="map_size_y" default="14.0"/>
    <arg name="map_size_z" default="3.0"/>
    <arg name="odom_topic" default="visual_slam/odom"/>
    <arg name="start_x" default="-6.0"/>
    <arg name="goal_x" default="10.0"/>
    <arg name="safety_distance" default="0.2"/>
    <arg name="formation_weight" default="200"/>
    <arg name="initial_assignment_enabled" default="true"/>

    <!-- These are identical to formation_6uav_criterion_auto_split_wall.launch. -->
    <arg name="wall_x" default="-2.0"/>
    <arg name="wall_y" default="0.0"/>
    <arg name="wall_size_x" default="0.5"/>
    <arg name="wall_size_y" default="4.0"/>
    <arg name="second_wall_x" default="6.5"/>
    <arg name="second_wall_size_x" default="0.5"/>
    <arg name="second_wall_total_size_y" default="10.0"/>
    <arg name="second_wall_gap_size_y" default="1.8"/>

    <include unless="$(arg distributed_enabled)" file="$(find swarm_bridge)/launch/bridge_udp.launch">
        <arg name="drone_id" value="999"/>
        <arg name="broadcast_ip" value="127.0.0.255"/>
    </include>

    <node if="$(eval arg('map_source') == 'split_merge_wall')"
          pkg="map_generator" type="fixed_split_merge_wall_map"
          name="fixed_split_merge_wall_map" output="screen" required="true">
        <remap from="global_cloud" to="/map_generator/global_cloud"/>
        <param name="first_wall_x" value="$(arg wall_x)"/>
        <param name="first_wall_y" value="$(arg wall_y)"/>
        <param name="first_wall_size_x" value="$(arg wall_size_x)"/>
        <param name="first_wall_size_y" value="$(arg wall_size_y)"/>
        <param name="second_wall_x" value="$(arg second_wall_x)"/>
        <param name="second_wall_y" value="$(arg wall_y)"/>
        <param name="second_wall_size_x" value="$(arg second_wall_size_x)"/>
        <param name="second_wall_total_size_y" value="$(arg second_wall_total_size_y)"/>
        <param name="second_wall_gap_size_y" value="$(arg second_wall_gap_size_y)"/>
        <param name="safety_distance" value="$(arg safety_distance)"/>
        <param name="resolution" value="0.1"/>
        <param name="height" value="3.0"/>
        <param name="randomize" value="false"/>
        <param name="random_seed" value="1"/>
    </node>

    <!-- Keep the renderer and observed-map model aligned at 360 degrees. -->
    <param name="/drone_0_pcl_render_node/full_360_sensing" value="true" type="bool"/>
    <param name="/drone_1_pcl_render_node/full_360_sensing" value="true" type="bool"/>
    <param name="/drone_2_pcl_render_node/full_360_sensing" value="true" type="bool"/>
    <param name="/drone_3_pcl_render_node/full_360_sensing" value="true" type="bool"/>
    <param name="/drone_4_pcl_render_node/full_360_sensing" value="true" type="bool"/>
    <param name="/drone_5_pcl_render_node/full_360_sensing" value="true" type="bool"/>
    <param name="/drone_6_pcl_render_node/full_360_sensing" value="true" type="bool"/>
    <param name="/drone_7_pcl_render_node/full_360_sensing" value="true" type="bool"/>

    <group unless="$(arg distributed_enabled)">
    <node pkg="ego_planner" type="swarm_observed_map_8uav_node"
          name="swarm_observed_map_8uav" output="screen" required="true">
        <param name="odom_topic_suffix" value="$(arg odom_topic)"/>
        <param name="cloud_topic_suffix" value="pcl_render_node/cloud"/>
        <param name="frame_id" value="world"/>
        <param name="resolution" value="0.20"/>
        <param name="sensor_range" value="5.0"/>
        <param name="horizontal_fov" value="6.283185307179586"/>
        <param name="azimuth_step" value="0.04"/>
        <param name="elevation_step" value="0.05"/>
        <param name="map_size_x" value="$(arg map_size_x)"/>
        <param name="map_size_y" value="$(arg map_size_y)"/>
        <param name="map_size_z" value="$(arg map_size_z)"/>
        <param name="ground_height" value="-0.01"/>
        <param name="min_update_period" value="0.15"/>
        <param name="min_observations_per_uav" value="3"/>
    </node>

    <node pkg="ego_planner" type="starconvex_shadow_8uav_node"
          name="starconvex_shadow_8uav" output="screen" required="true">
        <param name="odom_topic_suffix" value="$(arg odom_topic)"/>
        <param name="obstacle_cloud_topic" value="/swarm/observed_occupied"/>
        <param name="known_free_cloud_topic" value="/swarm/observed_free"/>
        <param name="map_timeout" value="1.0"/>
        <param name="map_warmup_duration" value="2.0"/>
        <param name="voxel_resolution" value="0.20"/>
        <param name="raycast_resolution" value="0.20"/>
        <param name="obstacle_inflation" value="$(arg safety_distance)"/>
        <param name="narrow_clearance" value="0.60"/>
        <param name="narrow_weight" value="0.45"/>
        <param name="known_free_corridor_radius" value="0.10"/>
        <param name="sensor_range" value="5.0"/>
        <param name="frontier_floor" value="0.0"/>
        <param name="frontier_roof" value="$(arg map_size_z)"/>
        <param name="delta_floor" value="-0.50"/>
        <param name="delta_roof" value="0.50"/>
        <param name="publish_rate" value="3.0"/>
        <param name="split_threshold" value="0.34"/>
        <param name="hard_split_threshold" value="0.20"/>
        <param name="merge_threshold" value="0.70"/>
        <param name="distance_split_threshold" value="1.8"/>
        <param name="distance_merge_threshold" value="1.7"/>
        <param name="persistence_distance" value="0.05"/>
        <param name="edge_cut_min_hold_duration" value="1.0"/>
        <param name="edge_reconnect_persistence" value="0.8"/>
        <param name="edge_reconnect_visibility_threshold" value="0.45"/>
        <param name="startup_topology_gate_enabled" value="true"/>
        <param name="startup_edge_ready_persistence" value="0.5"/>
        <param name="startup_topology_gate_max_wait" value="3.0"/>
        <param name="rear_split_propagation_enabled" value="true"/>
        <param name="rear_split_propagation_factor" value="1.3"/>
        <param name="rear_split_propagation_speed" value="$(arg max_vel)"/>
        <param name="rear_split_propagation_min_time" value="0.3"/>
        <param name="rear_split_propagation_max_time" value="6.0"/>
    </node>

    <node pkg="ego_planner" type="subgroup_route_intent_8uav_node"
          name="subgroup_route_intent_8uav" output="screen" required="true">
        <param name="odom_topic_suffix" value="$(arg odom_topic)"/>
        <param name="obstacle_cloud_topic" value="/swarm/observed_occupied"/>
        <param name="known_free_cloud_topic" value="/swarm/observed_free"/>
        <param name="voxel_resolution" value="0.20"/>
        <param name="obstacle_inflation" value="$(arg safety_distance)"/>
        <param name="sensor_range" value="5.0"/>
        <param name="raycast_resolution" value="0.20"/>
        <param name="publish_rate" value="5.0"/>
        <param name="goal_x" value="$(arg goal_x)"/>
        <param name="goal_y" value="0.0"/>
        <param name="feedback_enabled" value="false"/>
        <param name="lock_release_distance" value="3.0"/>
        <param name="lock_release_persistence" value="1.5"/>
        <param name="show_debug_text" value="false"/>
    </node>

    <node pkg="ego_planner" type="formation_auto_split_bridge_8uav_node"
          name="formation_auto_split_bridge_8uav" output="screen" required="true">
        <param name="criterion_summary_topic" value="/starconvex_shadow_8uav/summary"/>
        <param name="criterion_timeout" value="2.0"/>
        <param name="post_merge_baseline_timeout" value="6.0"/>
        <param name="post_merge_freshness_delay" value="0.3"/>
        <param name="split_ready_persistence" value="0.1"/>
        <param name="topology_change_persistence" value="0.1"/>
        <param name="secondary_hard_split_threshold" value="0.20"/>
        <param name="secondary_distance_split_threshold" value="1.8"/>
        <param name="auto_merge_enabled" value="true"/>
        <!-- Weak recovery may start at 3.0 m, but only declare the formation
             fully merged after every edge reaches the criterion's 1.7 m
             reconnect distance and remains ready for 0.8 s. -->
        <param name="merge_max_edge_distance" value="1.7"/>
        <param name="merge_ready_persistence" value="0.8"/>
        <param name="weak_reconnect_enabled" value="true"/>
        <param name="weak_reconnect_ready_persistence" value="0.8"/>
        <param name="weak_reconnect_visibility_threshold" value="1.0"/>
        <param name="weak_reconnect_max_edge_distance" value="3.0"/>
        <param name="weak_reconnect_formation_weight_scale" value="0.22"/>
        <param name="weak_reconnect_mid_formation_weight_scale" value="0.25"/>
        <param name="weak_reconnect_final_formation_weight_scale" value="0.30"/>
        <param name="weak_reconnect_ramp_step_duration" value="0.5"/>
        <param name="split_formation_weight_scale" value="0.15"/>
        <param name="split_progress_sync_weight_scale" value="0.0"/>
        <param name="ack_timeout" value="2.0"/>
    </node>

    <node pkg="ego_planner" type="formation_backend_visualizer_8uav_node"
          name="formation_backend_visualizer_8uav" output="screen">
        <param name="odom_topic_suffix" value="$(arg odom_topic)"/>
        <param name="frame_id" value="world"/>
        <param name="publish_rate" value="10.0"/>
    </node>

    <node if="$(arg initial_assignment_enabled)"
          pkg="ego_planner" type="initial_formation_assignment_8uav_node"
          name="initial_formation_assignment_8uav" output="screen" required="true">
        <param name="odom_topic_suffix" value="$(arg odom_topic)"/>
        <param name="settle_duration" value="0.5"/>
        <param name="odom_timeout" value="2.0"/>
        <param name="reassignment_interval" value="0.5"/>
        <param name="reassignment_stable_count" value="2"/>
        <param name="prediction_horizon" value="0.75"/>
        <param name="switch_penalty" value="0.25"/>
        <param name="minimum_improvement_ratio" value="0.15"/>
        <rosparam subst_value="true" param="formation_start">[$(arg start_x), 0.0, 1.5]</rosparam>
        <rosparam param="formation_slot0">[0.5, -1.5, 0.0]</rosparam>
        <rosparam param="formation_slot1">[0.5, -0.5, 0.0]</rosparam>
        <rosparam param="formation_slot2">[0.5, 0.5, 0.0]</rosparam>
        <rosparam param="formation_slot3">[0.5, 1.5, 0.0]</rosparam>
        <rosparam param="formation_slot4">[-0.5, -1.5, 0.0]</rosparam>
        <rosparam param="formation_slot5">[-0.5, -0.5, 0.0]</rosparam>
        <rosparam param="formation_slot6">[-0.5, 0.5, 0.0]</rosparam>
        <rosparam param="formation_slot7">[-0.5, 1.5, 0.0]</rosparam>
    </node>

    </group>

    <include file="$(find ego_planner)/launch/rectangle_8uav_member.launch">
        <arg name="distributed_enabled" value="$(arg distributed_enabled)"/>
        <arg name="swap_enabled" value="$(arg swap_enabled)"/>
        <arg name="initial_assignment_enabled" value="$(arg initial_assignment_enabled)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="0"/><arg name="init_x" value="$(eval float(arg('start_x')) + 0.5)"/><arg name="init_y" value="-1.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/><arg name="map_size_y" value="$(arg map_size_y)"/><arg name="map_size_z" value="$(arg map_size_z)"/><arg name="start_x" value="$(arg start_x)"/><arg name="goal_x" value="$(arg goal_x)"/><arg name="max_vel" value="$(arg max_vel)"/><arg name="formation_weight" value="$(arg formation_weight)"/>
    </include>
    <include file="$(find ego_planner)/launch/rectangle_8uav_member.launch">
        <arg name="distributed_enabled" value="$(arg distributed_enabled)"/>
        <arg name="initial_assignment_enabled" value="$(arg initial_assignment_enabled)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="1"/><arg name="init_x" value="$(eval float(arg('start_x')) + 0.5)"/><arg name="init_y" value="-0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/><arg name="map_size_y" value="$(arg map_size_y)"/><arg name="map_size_z" value="$(arg map_size_z)"/><arg name="start_x" value="$(arg start_x)"/><arg name="goal_x" value="$(arg goal_x)"/><arg name="max_vel" value="$(arg max_vel)"/><arg name="formation_weight" value="$(arg formation_weight)"/>
    </include>
    <include file="$(find ego_planner)/launch/rectangle_8uav_member.launch">
        <arg name="distributed_enabled" value="$(arg distributed_enabled)"/>
        <arg name="initial_assignment_enabled" value="$(arg initial_assignment_enabled)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="2"/><arg name="init_x" value="$(eval float(arg('start_x')) + 0.5)"/><arg name="init_y" value="0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/><arg name="map_size_y" value="$(arg map_size_y)"/><arg name="map_size_z" value="$(arg map_size_z)"/><arg name="start_x" value="$(arg start_x)"/><arg name="goal_x" value="$(arg goal_x)"/><arg name="max_vel" value="$(arg max_vel)"/><arg name="formation_weight" value="$(arg formation_weight)"/>
    </include>
    <include file="$(find ego_planner)/launch/rectangle_8uav_member.launch">
        <arg name="distributed_enabled" value="$(arg distributed_enabled)"/>
        <arg name="initial_assignment_enabled" value="$(arg initial_assignment_enabled)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="3"/><arg name="init_x" value="$(eval float(arg('start_x')) + 0.5)"/><arg name="init_y" value="1.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/><arg name="map_size_y" value="$(arg map_size_y)"/><arg name="map_size_z" value="$(arg map_size_z)"/><arg name="start_x" value="$(arg start_x)"/><arg name="goal_x" value="$(arg goal_x)"/><arg name="max_vel" value="$(arg max_vel)"/><arg name="formation_weight" value="$(arg formation_weight)"/>
    </include>
    <include file="$(find ego_planner)/launch/rectangle_8uav_member.launch">
        <arg name="distributed_enabled" value="$(arg distributed_enabled)"/>
        <arg name="initial_assignment_enabled" value="$(arg initial_assignment_enabled)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="4"/><arg name="init_x" value="$(eval float(arg('start_x')) - 0.5)"/><arg name="init_y" value="-1.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/><arg name="map_size_y" value="$(arg map_size_y)"/><arg name="map_size_z" value="$(arg map_size_z)"/><arg name="start_x" value="$(arg start_x)"/><arg name="goal_x" value="$(arg goal_x)"/><arg name="max_vel" value="$(arg max_vel)"/><arg name="formation_weight" value="$(arg formation_weight)"/>
    </include>
    <include file="$(find ego_planner)/launch/rectangle_8uav_member.launch">
        <arg name="distributed_enabled" value="$(arg distributed_enabled)"/>
        <arg name="initial_assignment_enabled" value="$(arg initial_assignment_enabled)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="5"/><arg name="init_x" value="$(eval float(arg('start_x')) - 0.5)"/><arg name="init_y" value="-0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/><arg name="map_size_y" value="$(arg map_size_y)"/><arg name="map_size_z" value="$(arg map_size_z)"/><arg name="start_x" value="$(arg start_x)"/><arg name="goal_x" value="$(arg goal_x)"/><arg name="max_vel" value="$(arg max_vel)"/><arg name="formation_weight" value="$(arg formation_weight)"/>
    </include>
    <include file="$(find ego_planner)/launch/rectangle_8uav_member.launch">
        <arg name="distributed_enabled" value="$(arg distributed_enabled)"/>
        <arg name="initial_assignment_enabled" value="$(arg initial_assignment_enabled)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="6"/><arg name="init_x" value="$(eval float(arg('start_x')) - 0.5)"/><arg name="init_y" value="0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/><arg name="map_size_y" value="$(arg map_size_y)"/><arg name="map_size_z" value="$(arg map_size_z)"/><arg name="start_x" value="$(arg start_x)"/><arg name="goal_x" value="$(arg goal_x)"/><arg name="max_vel" value="$(arg max_vel)"/><arg name="formation_weight" value="$(arg formation_weight)"/>
    </include>
    <include file="$(find ego_planner)/launch/rectangle_8uav_member.launch">
        <arg name="distributed_enabled" value="$(arg distributed_enabled)"/>
        <arg name="initial_assignment_enabled" value="$(arg initial_assignment_enabled)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="7"/><arg name="init_x" value="$(eval float(arg('start_x')) - 0.5)"/><arg name="init_y" value="1.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/><arg name="map_size_y" value="$(arg map_size_y)"/><arg name="map_size_z" value="$(arg map_size_z)"/><arg name="start_x" value="$(arg start_x)"/><arg name="goal_x" value="$(arg goal_x)"/><arg name="max_vel" value="$(arg max_vel)"/><arg name="formation_weight" value="$(arg formation_weight)"/>
    </include>

    <!-- Passive observer only: its failure must not stop the experiment. -->
    <node if="$(arg distributed_enabled)" pkg="ego_planner"
          type="distributed_formation_visualizer" name="distributed_formation_visualizer"
          output="log">
        <param name="odom_topic_suffix" value="$(arg odom_topic)"/>
        <param name="show_cut_edges" value="true"/>
    </node>
    <include if="$(arg rviz)" file="$(find ego_planner)/launch/rviz.launch"/>
</launch>
