<launch>
    <arg name="rviz" default="true"/>
    <arg name="map_source" default="split_merge_wall"/>
    <arg name="max_vel" default="0.5"/>
    <arg name="map_size_x" default="24.0"/>
    <arg name="map_size_y" default="14.0"/>
    <arg name="map_size_z" default="3.0"/>
    <arg name="odom_topic" default="visual_slam/odom"/>
    <arg name="start_x" default="-6.0"/>
    <arg name="goal_x" default="10.0"/>
    <arg name="safety_distance" default="0.2"/>
    <arg name="formation_weight" default="200"/>
    <arg name="wall_x" default="-2.0"/>
    <arg name="wall_y" default="0.0"/>
    <arg name="wall_size_x" default="0.5"/>
    <arg name="wall_size_y" default="4.0"/>
    <arg name="second_wall_x" default="6.5"/>
    <arg name="second_wall_size_x" default="0.5"/>
    <arg name="second_wall_total_size_y" default="10.0"/>
    <arg name="second_wall_gap_size_y" default="1.8"/>
    <arg name="start_planning" default="true"/>
    <arg name="full_360_sensing" default="true"/>
    <arg name="record_bag" default="false"/>
    <arg name="bag_prefix" default="/tmp/ego_original_8uav"/>
    <include file="$(find swarm_bridge)/launch/bridge_udp.launch">
        <arg name="drone_id" value="999"/>
        <arg name="broadcast_ip" value="127.0.0.255"/>
    </include>
    <node if="$(eval arg('map_source') == 'split_merge_wall')" pkg="map_generator" type="fixed_split_merge_wall_map" name="fixed_split_merge_wall_map" output="screen" required="true">
        <remap from="global_cloud" to="/map_generator/global_cloud"/>
        <param name="first_wall_x" value="$(arg wall_x)"/>
        <param name="first_wall_y" value="$(arg wall_y)"/>
        <param name="first_wall_size_x" value="$(arg wall_size_x)"/>
        <param name="first_wall_size_y" value="$(arg wall_size_y)"/>
        <param name="second_wall_x" value="$(arg second_wall_x)"/>
        <param name="second_wall_y" value="$(arg wall_y)"/>
        <param name="second_wall_size_x" value="$(arg second_wall_size_x)"/>
        <param name="second_wall_total_size_y" value="$(arg second_wall_total_size_y)"/>
        <param name="second_wall_gap_size_y" value="$(arg second_wall_gap_size_y)"/>
        <param name="safety_distance" value="$(arg safety_distance)"/>
        <param name="resolution" value="0.1"/>
        <param name="height" value="3.0"/>
        <param name="randomize" value="false"/>
        <param name="random_seed" value="1"/>
    </node>
    <include file="$(find ego_planner)/launch/baseline_8uav_member.launch">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="0"/>
        <arg name="init_x" value="$(eval float(arg('start_x')) + 0.5)"/>
        <arg name="init_y" value="-1.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="start_x" value="$(arg start_x)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="formation_weight" value="$(arg formation_weight)"/>
        <arg name="start_planning" value="$(arg start_planning)"/>
        <arg name="full_360_sensing" value="$(arg full_360_sensing)"/>
    </include>
    <include file="$(find ego_planner)/launch/baseline_8uav_member.launch">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="1"/>
        <arg name="init_x" value="$(eval float(arg('start_x')) + 0.5)"/>
        <arg name="init_y" value="-0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="start_x" value="$(arg start_x)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="formation_weight" value="$(arg formation_weight)"/>
        <arg name="start_planning" value="$(arg start_planning)"/>
        <arg name="full_360_sensing" value="$(arg full_360_sensing)"/>
    </include>
    <include file="$(find ego_planner)/launch/baseline_8uav_member.launch">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="2"/>
        <arg name="init_x" value="$(eval float(arg('start_x')) + 0.5)"/>
        <arg name="init_y" value="0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="start_x" value="$(arg start_x)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="formation_weight" value="$(arg formation_weight)"/>
        <arg name="start_planning" value="$(arg start_planning)"/>
        <arg name="full_360_sensing" value="$(arg full_360_sensing)"/>
    </include>
    <include file="$(find ego_planner)/launch/baseline_8uav_member.launch">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="3"/>
        <arg name="init_x" value="$(eval float(arg('start_x')) + 0.5)"/>
        <arg name="init_y" value="1.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="start_x" value="$(arg start_x)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="formation_weight" value="$(arg formation_weight)"/>
        <arg name="start_planning" value="$(arg start_planning)"/>
        <arg name="full_360_sensing" value="$(arg full_360_sensing)"/>
    </include>
    <include file="$(find ego_planner)/launch/baseline_8uav_member.launch">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="4"/>
        <arg name="init_x" value="$(eval float(arg('start_x')) - 0.5)"/>
        <arg name="init_y" value="-1.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="start_x" value="$(arg start_x)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="formation_weight" value="$(arg formation_weight)"/>
        <arg name="start_planning" value="$(arg start_planning)"/>
        <arg name="full_360_sensing" value="$(arg full_360_sensing)"/>
    </include>
    <include file="$(find ego_planner)/launch/baseline_8uav_member.launch">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="5"/>
        <arg name="init_x" value="$(eval float(arg('start_x')) - 0.5)"/>
        <arg name="init_y" value="-0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="start_x" value="$(arg start_x)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="formation_weight" value="$(arg formation_weight)"/>
        <arg name="start_planning" value="$(arg start_planning)"/>
        <arg name="full_360_sensing" value="$(arg full_360_sensing)"/>
    </include>
    <include file="$(find ego_planner)/launch/baseline_8uav_member.launch">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="6"/>
        <arg name="init_x" value="$(eval float(arg('start_x')) - 0.5)"/>
        <arg name="init_y" value="0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="start_x" value="$(arg start_x)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="formation_weight" value="$(arg formation_weight)"/>
        <arg name="start_planning" value="$(arg start_planning)"/>
        <arg name="full_360_sensing" value="$(arg full_360_sensing)"/>
    </include>
    <include file="$(find ego_planner)/launch/baseline_8uav_member.launch">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="drone_id" value="7"/>
        <arg name="init_x" value="$(eval float(arg('start_x')) - 0.5)"/>
        <arg name="init_y" value="1.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="start_x" value="$(arg start_x)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="formation_weight" value="$(arg formation_weight)"/>
        <arg name="start_planning" value="$(arg start_planning)"/>
        <arg name="full_360_sensing" value="$(arg full_360_sensing)"/>
    </include>
    <node if="$(arg record_bag)" pkg="rosbag" type="record" name="original_8uav_record" output="screen" args="-O $(arg bag_prefix).bag /map_generator/global_cloud /map_generator/wall_geometry /map_generator/sparse_random_geometry /rosout_agg /drone_0_$(arg odom_topic) /drone_0_planning/trajectory /drone_0_planning/pos_cmd /drone_1_$(arg odom_topic) /drone_1_planning/trajectory /drone_1_planning/pos_cmd /drone_2_$(arg odom_topic) /drone_2_planning/trajectory /drone_2_planning/pos_cmd /drone_3_$(arg odom_topic) /drone_3_planning/trajectory /drone_3_planning/pos_cmd /drone_4_$(arg odom_topic) /drone_4_planning/trajectory /drone_4_planning/pos_cmd /drone_5_$(arg odom_topic) /drone_5_planning/trajectory /drone_5_planning/pos_cmd /drone_6_$(arg odom_topic) /drone_6_planning/trajectory /drone_6_planning/pos_cmd /drone_7_$(arg odom_topic) /drone_7_planning/trajectory /drone_7_planning/pos_cmd"/>
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find ego_planner)/launch/baseline_8uav.rviz" required="true"/>
</launch>
