<launch>
    <!-- Current-state point-cloud StarConvex/visibility criterion connected to
         the same one-way INTACT -> SPLIT backend gate used by the pillar test. -->
    <arg name="rviz" default="true"/>
    <arg name="max_vel" default="0.3"/>
    <arg name="goal_x" default="8.0"/>
    <arg name="wall_size_x" default="0.5"/>
    <arg name="wall_size_y" default="4.7"/>
    <arg name="safety_distance" default="0.2"/>
    <arg name="wall_guard_check_horizon" default="3.0"/>
    <arg name="rear_split_propagation_enabled" default="true"/>
    <arg name="rear_split_propagation_factor" default="1.3"/>
    <arg name="rear_split_propagation_min_time" default="0.3"/>
    <arg name="rear_split_propagation_max_time" default="6.0"/>
    <arg name="auto_merge_enabled" default="true"/>
    <arg name="auto_merge_after_wall_margin" default="1.5"/>
    <arg name="auto_merge_ready_persistence" default="1.0"/>
    <arg name="auto_merge_candidate_min_score" default="0.35"/>
    <arg name="post_merge_intact_persistence" default="1.0"/>
    <arg name="staged_merge_enabled" default="false"/>
    <arg name="row_merge_after_wall_margin" default="0.5"/>
    <arg name="row_merge_ready_persistence" default="0.5"/>
    <arg name="row_merge_score_threshold" default="0.70"/>
    <arg name="row_merge_formation_weight_scale" default="0.25"/>
    <arg name="autonomous_edge_merge_enabled" default="true"/>
    <arg name="edge_soft_reconnect_score_threshold" default="0.50"/>
    <arg name="edge_merge_score_threshold" default="0.70"/>
    <arg name="edge_merge_ready_persistence" default="0.5"/>
    <arg name="edge_full_merge_ready_persistence" default="0.5"/>
    <arg name="edge_merge_formation_weight_scale" default="0.15"/>
    <arg name="edge_merge_max_distance" default="4.0"/>
    <arg name="edge_full_merge_max_distance" default="2.5"/>
    <arg name="edge_merge_use_wall_gate" default="true"/>
    <arg name="global_intact_soft_reconnect_enabled" default="false"/>
    <arg name="global_intact_soft_reconnect_persistence" default="0.4"/>
    <arg name="edge_cut_score_threshold" default="0.34"/>
    <arg name="edge_hard_cut_score_threshold" default="0.20"/>
    <arg name="edge_cut_ready_persistence" default="1.2"/>
    <arg name="edge_cut_stall_progress" default="0.10"/>
    <arg name="edge_cut_fallback_persistence" default="3.0"/>
    <arg name="split_min_merge_delay" default="3.0"/>
    <arg name="subgroup_route_intent_feedback_enabled" default="false"/>
    <arg name="subgroup_route_intent_show_debug_text" default="false"/>
    <arg name="formation_weight" default="100"/>
    <!-- Temporarily disable the preset left/right assignment.  Keep the
         argument exposed so it can still be enabled explicitly for ablations. -->
    <arg name="split_side_guidance_enabled" default="false"/>
    <arg name="split_progress_sync_weight_scale" default="0.0"/>
    <arg name="split_progress_sync_deadband" default="0.6"/>
    <arg name="merge_direction_min_speed" default="0.05"/>

    <include file="$(find ego_planner)/launch/formation_4uav_criterion_shadow.launch">
        <arg name="rviz" value="$(arg rviz)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="goal_x" value="$(arg goal_x)"/>
        <arg name="map_shape" value="wall"/>
        <arg name="wall_size_x" value="$(arg wall_size_x)"/>
        <arg name="wall_size_y" value="$(arg wall_size_y)"/>
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="wall_guard_check_horizon" value="$(arg wall_guard_check_horizon)"/>
        <arg name="criterion_obstacle_model" value="pointcloud"/>
        <arg name="obstacle_cloud_topic" value="/map_generator/global_cloud"/>
        <arg name="voxel_resolution" value="0.10"/>
        <arg name="starconvex_frontier_floor" value="0.50"/>
        <arg name="starconvex_frontier_roof" value="2.50"/>
        <arg name="starconvex_delta_floor" value="-0.50"/>
        <arg name="starconvex_delta_roof" value="0.50"/>
        <arg name="criterion_publish_rate" value="40.0"/>
        <arg name="merge_direction_min_speed" value="$(arg merge_direction_min_speed)"/>
        <arg name="rear_split_propagation_enabled" value="$(arg rear_split_propagation_enabled)"/>
        <arg name="rear_split_propagation_factor" value="$(arg rear_split_propagation_factor)"/>
        <arg name="rear_split_propagation_min_time" value="$(arg rear_split_propagation_min_time)"/>
        <arg name="rear_split_propagation_max_time" value="$(arg rear_split_propagation_max_time)"/>
        <arg name="auto_merge_enabled" value="$(arg auto_merge_enabled)"/>
        <arg name="auto_merge_after_wall_margin" value="$(arg auto_merge_after_wall_margin)"/>
        <arg name="auto_merge_ready_persistence" value="$(arg auto_merge_ready_persistence)"/>
        <arg name="auto_merge_candidate_min_score" value="$(arg auto_merge_candidate_min_score)"/>
        <arg name="post_merge_intact_persistence" value="$(arg post_merge_intact_persistence)"/>
        <arg name="staged_merge_enabled" value="$(arg staged_merge_enabled)"/>
        <arg name="row_merge_after_wall_margin" value="$(arg row_merge_after_wall_margin)"/>
        <arg name="row_merge_ready_persistence" value="$(arg row_merge_ready_persistence)"/>
        <arg name="row_merge_score_threshold" value="$(arg row_merge_score_threshold)"/>
        <arg name="row_merge_formation_weight_scale" value="$(arg row_merge_formation_weight_scale)"/>
        <arg name="autonomous_edge_merge_enabled" value="$(arg autonomous_edge_merge_enabled)"/>
        <arg name="edge_soft_reconnect_score_threshold" value="$(arg edge_soft_reconnect_score_threshold)"/>
        <arg name="edge_merge_score_threshold" value="$(arg edge_merge_score_threshold)"/>
        <arg name="edge_merge_ready_persistence" value="$(arg edge_merge_ready_persistence)"/>
        <arg name="edge_full_merge_ready_persistence" value="$(arg edge_full_merge_ready_persistence)"/>
        <arg name="edge_merge_formation_weight_scale" value="$(arg edge_merge_formation_weight_scale)"/>
        <arg name="edge_merge_max_distance" value="$(arg edge_merge_max_distance)"/>
        <arg name="edge_full_merge_max_distance" value="$(arg edge_full_merge_max_distance)"/>
        <arg name="edge_merge_use_wall_gate" value="$(arg edge_merge_use_wall_gate)"/>
        <arg name="global_intact_soft_reconnect_enabled" value="$(arg global_intact_soft_reconnect_enabled)"/>
        <arg name="global_intact_soft_reconnect_persistence" value="$(arg global_intact_soft_reconnect_persistence)"/>
        <arg name="edge_cut_score_threshold" value="$(arg edge_cut_score_threshold)"/>
        <arg name="edge_hard_cut_score_threshold" value="$(arg edge_hard_cut_score_threshold)"/>
        <arg name="edge_cut_ready_persistence" value="$(arg edge_cut_ready_persistence)"/>
        <arg name="edge_cut_stall_progress" value="$(arg edge_cut_stall_progress)"/>
        <arg name="edge_cut_fallback_persistence" value="$(arg edge_cut_fallback_persistence)"/>
        <arg name="split_min_merge_delay" value="$(arg split_min_merge_delay)"/>
        <arg name="split_side_guidance_enabled" value="$(arg split_side_guidance_enabled)"/>
        <arg name="split_side_guidance_weight" value="600.0"/>
        <arg name="split_side_guidance_margin" value="0.35"/>
        <arg name="split_subgroup_formation_weight_scale" value="0.10"/>
        <arg name="split_progress_sync_weight_scale" value="$(arg split_progress_sync_weight_scale)"/>
        <arg name="split_progress_sync_deadband" value="$(arg split_progress_sync_deadband)"/>
        <!-- Keep route-intent feedback disabled by default so the fair
             baseline differs only in whether the criterion may change backend
             topology.  It can still be enabled explicitly from roslaunch for
             ablation/debug runs. -->
        <arg name="subgroup_route_intent_feedback_enabled" value="$(arg subgroup_route_intent_feedback_enabled)"/>
        <arg name="subgroup_route_intent_weight" value="80.0"/>
        <arg name="subgroup_route_intent_corridor_half_width" value="0.25"/>
        <arg name="subgroup_route_intent_show_debug_text" value="$(arg subgroup_route_intent_show_debug_text)"/>
        <arg name="formation_weight" value="$(arg formation_weight)"/>
        <arg name="manual_split" value="false"/>
        <arg name="enable_auto_split" value="true"/>
    </include>
</launch>
